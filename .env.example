# Express API and static production server
PORT=4190

# Optional Blockscout-compatible token instance index base
GENESIS_INDEXER_URL=https://arbitrum.blockscout.com/api/v2/tokens

# Persistent off-chain reserve registry JSON file
NODE_REGISTRY_FILE=./data/node-registry.json

# Optional Arbitrum One JSON-RPC URL (defaults to the public Arbitrum RPC)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
