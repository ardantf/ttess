{
  "name": "kryvora-genesis-fusion-registry",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "serve": "tsx server.ts",
    "start": "npm run build && npm run serve",
    "build": "vite build",
    "build:realm": "node --preserve-symlinks --preserve-symlinks-main scripts/build-realm.mjs",
    "preview:realm": "node --preserve-symlinks --preserve-symlinks-main --loader ./scripts/local-ts-loader.mjs scripts/preview-realm.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:realm": "node scripts/test-realm.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.103.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.0",
    "viem": "^2.56.5",
    "vite": "^6.2.3",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
